rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isClassTeacher(classroomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
    }
    function canReadBook(bookId, uid) {
      return exists(/databases/$(database)/documents/books/$(bookId))
        && (
          uid in get(/databases/$(database)/documents/books/$(bookId)).data.assignedStudentIds
          || get(/databases/$(database)/documents/books/$(bookId)).data.uploadedBy == uid
        );
    }
    function validProgressData(data) {
      return data.keys().hasOnly([
          'studentId',
          'bookId',
          'classroomId',
          'lastReadPage',
          'highestPageRead',
          'totalPages',
          'completionPercent',
          'totalSecondsRead',
          'completed',
          'lastReadAt',
          'createdAt'
        ])
        && data.studentId is string
        && data.bookId is string
        && data.lastReadPage is int
        && data.highestPageRead is int
        && data.totalPages is int
        && data.completionPercent is int
        && data.totalSecondsRead is int
        && data.completed is bool
        && data.lastReadPage >= 1
        && data.highestPageRead >= 1
        && data.totalPages >= 0
        && data.completionPercent >= 0
        && data.completionPercent <= 100
        && data.totalSecondsRead >= 0;
    }
    function validAnnotationData(data) {
      return data.keys().hasOnly([
          'studentId',
          'bookId',
          'classroomId',
          'pageNumber',
          'reactionType',
          'noteText',
          'selectedText',
          'annotationKind',
          'timestamp'
        ])
        && data.keys().hasAll([
          'studentId',
          'bookId',
          'classroomId',
          'pageNumber',
          'reactionType',
          'noteText',
          'selectedText',
          'annotationKind',
          'timestamp'
        ])
        && data.studentId is string
        && data.bookId is string
        && (data.classroomId == null || data.classroomId is string)
        && data.pageNumber is int
        && data.pageNumber >= 1
        && data.reactionType in ['surprise', 'think', 'love', 'important', 'question']
        && data.noteText is string
        && data.selectedText is string
        && data.annotationKind in ['annotation', 'reflection']
        && (
          (data.annotationKind == 'annotation' && data.noteText.size() <= 500)
          || (data.annotationKind == 'reflection' && data.noteText.size() <= 600)
        )
        && data.timestamp is timestamp;
    }
    function validAnnotationClassroomLink(data) {
      return data.classroomId == null
        || (
          exists(/databases/$(database)/documents/classrooms/$(data.classroomId))
          && request.auth.uid in get(/databases/$(database)/documents/classrooms/$(data.classroomId)).data.studentIds
        );
    }
    // The teacher who uploaded the book, for a record naming that book and a
    // student the book is assigned to. Used by annotations, organizers and
    // readingProgress alike — each carries bookId + studentId.
    function isAssignedBookTeacher(data) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/books/$(data.bookId))
        && get(/databases/$(database)/documents/books/$(data.bookId)).data.uploadedBy == request.auth.uid
        && data.studentId in get(/databases/$(database)/documents/books/$(data.bookId)).data.assignedStudentIds;
    }
    function isClassStudent(classroomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && request.auth.uid in get(/databases/$(database)/documents/classrooms/$(classroomId)).data.studentIds;
    }
    function writingTaskData(taskId) {
      return get(/databases/$(database)/documents/writingTasks/$(taskId)).data;
    }
    function canAccessWritingTask(taskId) {
      return exists(/databases/$(database)/documents/writingTasks/$(taskId))
        && (
          writingTaskData(taskId).createdBy == request.auth.uid
          || (
            writingTaskData(taskId).classroomId is string
            && isClassStudent(writingTaskData(taskId).classroomId)
          )
        );
    }

    // ── users ─────────────────────────────────────────────────────────────
    // Read: the account owner, plus the teacher of the classroom this user is
    // currently enrolled in. That second branch is what the teacher dashboards
    // need — every one of them maps over its own classroom.studentIds calling
    // getUserProfile(id) to put a name on a row.
    //
    // This used to be `allow read: if isSignedIn()`, on the reasoning that
    // "teachers need to look up student display names". It let ANY signed-in
    // account read EVERY user document: every student's display name, role and
    // classroom, and every teacher's email and stripeCustomerId. That is an
    // unauthorized disclosure of education records under FERPA, and it is the
    // hole this branch closes — the lookup teachers actually need is scoped to
    // their own roster, and nothing else was ever using the broad read.
    //
    // Un-enrolment revokes it for free: removeStudentFromClassroom clears the
    // student's own classroomId, so this branch stops matching the moment they
    // leave the roster. Teacher and individual profiles carry classroomId null,
    // so no one but the owner can read them at all.
    match /users/{uid} {
      allow read: if isOwner(uid)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        );
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        // A classroom's teacher may clear that student's classroomId when
        // removing them from the roster — that key only, and only to null.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classroomId'])
          && request.resource.data.classroomId == null
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        );
    }

    // ── classrooms ────────────────────────────────────────────────────────
    // Read: the teacher who owns it, or a student currently on its roster.
    //
    // This used to be `allow read: if isSignedIn()` so the client could look a
    // join code up at registration. That published every classroom in the
    // product to every signed-in account — the full roster of student uids AND
    // the join code needed to walk into it. Join-code lookup is now the
    // joinClassroom callable's job (functions/src/classroom.ts), which runs as
    // admin and never hands the classroom back to an unenrolled caller.
    //
    // Create is closed to clients entirely. A classroom's join code has to be
    // unique across the whole collection, and proving that means querying
    // classrooms the creator cannot read — the check has to be server-side, so
    // the write is too. It also has to be: a client that picks its own join
    // code can mint one that collides with a real teacher's, and students who
    // typed their teacher's code would land on the attacker's roster, whose
    // annotations the attacker then reads as isClassTeacher. createClassroom
    // in functions/src/classroom.ts is the only way in.
    //
    // Update no longer carries a self-add-to-studentIds branch. It checked
    // only that the caller was adding themselves and adding exactly one id —
    // never that they knew the join code, because the code is never part of
    // the written document and a rule cannot see a query's filter values. Any
    // signed-in account could therefore enrol itself in any classroom it could
    // read, which was all of them. Enrolment is the callable's job now.
    match /classrooms/{classroomId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.teacherId)
        || request.auth.uid in resource.data.studentIds
      );
      allow create: if false;
      allow update: if isSignedIn() && isOwner(resource.data.teacherId);
      allow delete: if isSignedIn() && isOwner(resource.data.teacherId);
    }

    // ── books ─────────────────────────────────────────────────────────────
    // Read: any signed-in user who appears in assignedStudentIds, OR the teacher
    //       who uploaded it, OR a student reading their own uploaded book.
    // Create: any signed-in user, filing the book under their own uid
    //         (teacher uploads or student self-upload). For student books the
    //         app sets uploadedBy = uid and assignedStudentIds = [uid].
    // Update/delete: only the user who originally uploaded the book.
    match /books/{bookId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.assignedStudentIds
        || isOwner(resource.data.uploadedBy)
      );

      // Either kind of upload must claim itself: uploadedBy is the author's own
      // uid. The teacher branch used to assert nothing but "signed in", which
      // let any account file a book under another teacher's name.
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && (
          // Teacher upload
          !request.resource.data.keys().hasAll(['uploadedByStudent'])
          // Student self-upload — must also be in assignedStudentIds
          || (request.resource.data.uploadedByStudent == true
              && request.auth.uid in request.resource.data.assignedStudentIds)
        );

      // Only the uploader. The self-add-to-assignedStudentIds branch that used
      // to live here was the same hole as the classrooms one: it proved the
      // caller was adding themselves, never that they were entitled to. Any
      // signed-in account could assign itself any book in the product and read
      // the PDF. joinClassroom assigns the teacher's library server-side now.
      allow update: if isSignedIn() && isOwner(resource.data.uploadedBy);
      allow delete: if isSignedIn() && isOwner(resource.data.uploadedBy);
    }

    // ── annotations ───────────────────────────────────────────────────────
    // Students own their annotations. A teacher reads one only by standing in
    // a named relation to it: teacher of the classroom the annotation is
    // pinned to, or the teacher who uploaded the book it is on and who has
    // that student assigned to it. There is no role check and no blanket
    // signed-in read — the two predicates below are the whole grant.
    match /annotations/{annotationId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
        || isAssignedBookTeacher(resource.data)
      );
      allow create: if isSignedIn()
                    && validAnnotationData(request.resource.data)
                    && request.resource.data.studentId == request.auth.uid
                    && canReadBook(request.resource.data.bookId, request.auth.uid)
                    && validAnnotationClassroomLink(request.resource.data);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && validAnnotationData(request.resource.data)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.bookId == resource.data.bookId
                    && request.resource.data.classroomId == resource.data.classroomId
                    && request.resource.data.pageNumber == resource.data.pageNumber
                    && request.resource.data.annotationKind == resource.data.annotationKind;
      allow delete: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || isAssignedBookTeacher(resource.data)
      );
    }

    // ── organizers ───────────────────────────────────────────────────────
    // Students own their organizer responses; teachers read responses for
    // students in their classroom.
    match /organizers/{organizerId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
      );
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && canReadBook(request.resource.data.bookId, request.auth.uid);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.bookId == resource.data.bookId
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || isAssignedBookTeacher(resource.data)
      );
    }

    // ── writing tasks (book-free) ─────────────────────────────────────────
    // Read: the creator (teacher or a learner's personal task), plus the
    //       students and teacher of the assigned classroom.
    // Create: any signed-in user, writing their own createdBy.
    // Update/delete: only the creator. classroomId + createdBy are immutable.
    match /writingTasks/{taskId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.createdBy)
        || (
          resource.data.classroomId is string
          && (isClassStudent(resource.data.classroomId) || isClassTeacher(resource.data.classroomId))
        )
      );
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.templateId is string
                    && (request.resource.data.classroomId == null || request.resource.data.classroomId is string);
      allow update: if isSignedIn()
                    && isOwner(resource.data.createdBy)
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && isOwner(resource.data.createdBy);
    }

    // ── writing responses (book-free) ─────────────────────────────────────
    // Students own their responses; the assigned classroom's teacher can read.
    // Personal tasks carry classroomId == null, so only the owner can read them.
    match /writingResponses/{responseId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (
          resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
      );
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && canAccessWritingTask(request.resource.data.taskId)
                    // classroomId must match the task's own scope — a student
                    // can't hide assigned work (null) or misattribute it.
                    && request.resource.data.classroomId == writingTaskData(request.resource.data.taskId).classroomId;
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.taskId == resource.data.taskId
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && isOwner(resource.data.studentId);
    }

    // ── writing feedback (teacher → student) ──────────────────────────────
    // Written only by the classroom's teacher; read by that teacher and the
    // student the feedback is about. Kept separate from the student-owned
    // response so each side writes only its own document.
    match /writingFeedback/{feedbackId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (resource.data.classroomId is string && isClassTeacher(resource.data.classroomId))
      );
      allow create: if isSignedIn()
                    && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.classroomId is string
                    && isClassTeacher(request.resource.data.classroomId);
      allow update: if isSignedIn()
                    && isClassTeacher(resource.data.classroomId)
                    && request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.taskId == resource.data.taskId
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && isClassTeacher(resource.data.classroomId);
    }

    // ── reading progress ─────────────────────────────────────────────────
    // Students update their own reading progress. Teachers can read progress
    // only for students in a classroom they own.
    match /readingProgress/{progressId} {
      allow read: if isSignedIn() && (
        resource == null
        || isOwner(resource.data.studentId)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
      );
      allow create: if isSignedIn()
                    && validProgressData(request.resource.data)
                    && request.resource.data.studentId == request.auth.uid
                    && canReadBook(request.resource.data.bookId, request.auth.uid);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && validProgressData(request.resource.data)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.bookId == resource.data.bookId
                    && request.resource.data.classroomId == resource.data.classroomId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.totalSecondsRead >= resource.data.totalSecondsRead
                    && request.resource.data.highestPageRead >= resource.data.highestPageRead
                    && request.resource.data.completionPercent >= resource.data.completionPercent;
      allow delete: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || isAssignedBookTeacher(resource.data)
      );
    }
  }
}
