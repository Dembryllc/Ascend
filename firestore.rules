rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isClassTeacher(classroomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
    }
    function canReadBook(bookId, uid) {
      return exists(/databases/$(database)/documents/books/$(bookId))
        && (
          uid in get(/databases/$(database)/documents/books/$(bookId)).data.assignedStudentIds
          || get(/databases/$(database)/documents/books/$(bookId)).data.uploadedBy == uid
        );
    }
    function validProgressData(data) {
      return data.keys().hasOnly([
          'studentId',
          'bookId',
          'classroomId',
          'lastReadPage',
          'highestPageRead',
          'totalPages',
          'completionPercent',
          'totalSecondsRead',
          'completed',
          'lastReadAt',
          'createdAt'
        ])
        && data.studentId is string
        && data.bookId is string
        && data.lastReadPage is int
        && data.highestPageRead is int
        && data.totalPages is int
        && data.completionPercent is int
        && data.totalSecondsRead is int
        && data.completed is bool
        && data.lastReadPage >= 1
        && data.highestPageRead >= 1
        && data.totalPages >= 0
        && data.completionPercent >= 0
        && data.completionPercent <= 100
        && data.totalSecondsRead >= 0;
    }
    function validAnnotationData(data) {
      return data.keys().hasOnly([
          'studentId',
          'bookId',
          'classroomId',
          'pageNumber',
          'reactionType',
          'noteText',
          'selectedText',
          'annotationKind',
          'timestamp'
        ])
        && data.keys().hasAll([
          'studentId',
          'bookId',
          'classroomId',
          'pageNumber',
          'reactionType',
          'noteText',
          'selectedText',
          'annotationKind',
          'timestamp'
        ])
        && data.studentId is string
        && data.bookId is string
        && (data.classroomId == null || data.classroomId is string)
        && data.pageNumber is int
        && data.pageNumber >= 1
        && data.reactionType in ['surprise', 'think', 'love', 'important', 'question']
        && data.noteText is string
        && data.selectedText is string
        && data.annotationKind in ['annotation', 'reflection']
        && (
          (data.annotationKind == 'annotation' && data.noteText.size() <= 500)
          || (data.annotationKind == 'reflection' && data.noteText.size() <= 600)
        )
        && data.timestamp is timestamp;
    }
    function validAnnotationClassroomLink(data) {
      return data.classroomId == null
        || (
          exists(/databases/$(database)/documents/classrooms/$(data.classroomId))
          && request.auth.uid in get(/databases/$(database)/documents/classrooms/$(data.classroomId)).data.studentIds
        );
    }
    function isBookTeacherForAnnotation(data) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/books/$(data.bookId))
        && get(/databases/$(database)/documents/books/$(data.bookId)).data.uploadedBy == request.auth.uid
        && data.studentId in get(/databases/$(database)/documents/books/$(data.bookId)).data.assignedStudentIds;
    }
    function isClassStudent(classroomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && request.auth.uid in get(/databases/$(database)/documents/classrooms/$(classroomId)).data.studentIds;
    }
    function writingTaskData(taskId) {
      return get(/databases/$(database)/documents/writingTasks/$(taskId)).data;
    }
    function canAccessWritingTask(taskId) {
      return exists(/databases/$(database)/documents/writingTasks/$(taskId))
        && (
          writingTaskData(taskId).createdBy == request.auth.uid
          || (
            writingTaskData(taskId).classroomId is string
            && isClassStudent(writingTaskData(taskId).classroomId)
          )
        );
    }

    // ── users ─────────────────────────────────────────────────────────────
    // Users read their own profile, or any authenticated user can read
    // profiles (teachers need to look up student display names).
    // Only the account owner may write their own document.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // ── classrooms ────────────────────────────────────────────────────────
    // Any signed-in user may read classrooms (join-code lookup at registration).
    // Only the teacher who owns the classroom may write it.
    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.teacherId)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
          && !(request.auth.uid in resource.data.studentIds)
          && request.auth.uid in request.resource.data.studentIds
          && request.resource.data.studentIds.hasAll(resource.data.studentIds)
          && request.resource.data.studentIds.size() == resource.data.studentIds.size() + 1
        )
      );
      allow delete: if isSignedIn() && isOwner(resource.data.teacherId);
    }

    // ── books ─────────────────────────────────────────────────────────────
    // Read: any signed-in user who appears in assignedStudentIds, OR the teacher
    //       who uploaded it, OR a student reading their own uploaded book.
    // Create: any signed-in user (teacher uploads or student self-upload).
    //         For student books the app sets uploadedBy = uid and
    //         assignedStudentIds = [uid] — enforced here.
    // Update/delete: only the user who originally uploaded the book.
    match /books/{bookId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.assignedStudentIds
        || isOwner(resource.data.uploadedBy)
      );

      allow create: if isSignedIn() && (
        // Teacher upload — no special constraints beyond being signed in
        !request.resource.data.keys().hasAll(['uploadedByStudent'])
        // Student self-upload — must own the doc and be in assignedStudentIds
        || (request.resource.data.uploadedByStudent == true
            && request.resource.data.uploadedBy == request.auth.uid
            && request.auth.uid in request.resource.data.assignedStudentIds)
      );

      allow update: if isSignedIn() && (
        isOwner(resource.data.uploadedBy)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedStudentIds'])
          && request.auth.uid in request.resource.data.assignedStudentIds
          && !(request.auth.uid in resource.data.assignedStudentIds)
          && request.resource.data.assignedStudentIds.hasAll(resource.data.assignedStudentIds)
          && request.resource.data.assignedStudentIds.size() == resource.data.assignedStudentIds.size() + 1
        )
      );
      allow delete: if isSignedIn() && isOwner(resource.data.uploadedBy);
    }

    // ── annotations ───────────────────────────────────────────────────────
    // Students own their annotations; teachers can read any annotation
    // (needed for the annotations viewer dashboard).
    // We avoid a role lookup by letting any signed-in user read — the app
    // only ever queries annotations scoped to a specific studentId or bookId.
    match /annotations/{annotationId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
        || isBookTeacherForAnnotation(resource.data)
      );
      allow create: if isSignedIn()
                    && validAnnotationData(request.resource.data)
                    && request.resource.data.studentId == request.auth.uid
                    && canReadBook(request.resource.data.bookId, request.auth.uid)
                    && validAnnotationClassroomLink(request.resource.data);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && validAnnotationData(request.resource.data)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.bookId == resource.data.bookId
                    && request.resource.data.classroomId == resource.data.classroomId
                    && request.resource.data.pageNumber == resource.data.pageNumber
                    && request.resource.data.annotationKind == resource.data.annotationKind;
      allow delete: if isSignedIn() && isOwner(resource.data.studentId);
    }

    // ── organizers ───────────────────────────────────────────────────────
    // Students own their organizer responses; teachers read responses for
    // students in their classroom.
    match /organizers/{organizerId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
      );
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && canReadBook(request.resource.data.bookId, request.auth.uid);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.bookId == resource.data.bookId
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && isOwner(resource.data.studentId);
    }

    // ── writing tasks (book-free) ─────────────────────────────────────────
    // Read: the creator (teacher or a learner's personal task), plus the
    //       students and teacher of the assigned classroom.
    // Create: any signed-in user, writing their own createdBy.
    // Update/delete: only the creator. classroomId + createdBy are immutable.
    match /writingTasks/{taskId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.createdBy)
        || (
          resource.data.classroomId is string
          && (isClassStudent(resource.data.classroomId) || isClassTeacher(resource.data.classroomId))
        )
      );
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.templateId is string
                    && (request.resource.data.classroomId == null || request.resource.data.classroomId is string);
      allow update: if isSignedIn()
                    && isOwner(resource.data.createdBy)
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && isOwner(resource.data.createdBy);
    }

    // ── writing responses (book-free) ─────────────────────────────────────
    // Students own their responses; the assigned classroom's teacher can read.
    // Personal tasks carry classroomId == null, so only the owner can read them.
    match /writingResponses/{responseId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId)
        || (
          resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
      );
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && canAccessWritingTask(request.resource.data.taskId);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.taskId == resource.data.taskId
                    && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if isSignedIn() && isOwner(resource.data.studentId);
    }

    // ── reading progress ─────────────────────────────────────────────────
    // Students update their own reading progress. Teachers can read progress
    // only for students in a classroom they own.
    match /readingProgress/{progressId} {
      allow read: if isSignedIn() && (
        resource == null
        || isOwner(resource.data.studentId)
        || (
          resource.data.keys().hasAll(['classroomId'])
          && resource.data.classroomId is string
          && isClassTeacher(resource.data.classroomId)
        )
      );
      allow create: if isSignedIn()
                    && validProgressData(request.resource.data)
                    && request.resource.data.studentId == request.auth.uid
                    && canReadBook(request.resource.data.bookId, request.auth.uid);
      allow update: if isSignedIn()
                    && isOwner(resource.data.studentId)
                    && validProgressData(request.resource.data)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.bookId == resource.data.bookId
                    && request.resource.data.classroomId == resource.data.classroomId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.totalSecondsRead >= resource.data.totalSecondsRead
                    && request.resource.data.highestPageRead >= resource.data.highestPageRead
                    && request.resource.data.completionPercent >= resource.data.completionPercent;
      allow delete: if isSignedIn() && isOwner(resource.data.studentId);
    }
  }
}
