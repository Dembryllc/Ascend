rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacher() {
      return isSignedIn() && userRole() == 'teacher';
    }
    function isStudent() {
      return isSignedIn() && userRole() == 'student';
    }

    // ── users ─────────────────────────────────────────────────────────────
    // Anyone can read their own profile; teachers can read student profiles
    // (needed to list classroom members). Write only to own document.
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // ── classrooms ────────────────────────────────────────────────────────
    // Teachers: full CRUD on classrooms they own.
    // Students: read-only on the classroom they belong to (for join-code lookup at registration).
    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update: if isTeacher() && isOwner(resource.data.teacherId);
      allow delete: if isTeacher() && isOwner(resource.data.teacherId);
    }

    // ── books ─────────────────────────────────────────────────────────────
    // Teachers: read/write books they uploaded.
    // Students:
    //   - read any book where they appear in assignedStudentIds
    //   - create books where uploadedByStudent == true and uploadedBy == their uid
    //   - update/delete only books they personally uploaded (uploadedBy == uid)
    match /books/{bookId} {
      allow read: if isTeacher()
                  || (isStudent() && request.auth.uid in resource.data.assignedStudentIds);

      allow create: if isTeacher()
                    || (isStudent()
                        && request.resource.data.uploadedBy == request.auth.uid
                        && request.resource.data.uploadedByStudent == true
                        && request.auth.uid in request.resource.data.assignedStudentIds);

      allow update: if (isTeacher() && isOwner(resource.data.uploadedBy))
                    || (isStudent() && isOwner(resource.data.uploadedBy));

      allow delete: if (isTeacher() && isOwner(resource.data.uploadedBy))
                    || (isStudent() && isOwner(resource.data.uploadedBy));
    }

    // ── annotations ───────────────────────────────────────────────────────
    // Students: full CRUD on their own annotations only.
    // Teachers: read-only on annotations belonging to students in their classroom.
    match /annotations/{annotationId} {
      allow read: if isOwner(resource.data.studentId) || isTeacher();
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isStudent() && isOwner(resource.data.studentId);
      allow delete: if isStudent() && isOwner(resource.data.studentId);
    }
  }
}
