rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Teacher-uploaded books: any authenticated user can read (needed to render PDFs).
    // Only authenticated teachers can write.
    match /books/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Student-uploaded books: stored under their uid folder.
    // Only the owning student can write or delete; any authenticated user can read.
    match /student-books/{studentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == studentId;
    }
  }
}
